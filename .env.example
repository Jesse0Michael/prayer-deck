# Copy to .env to configure `make run` and `docker compose`.

# Hostname browsers use to reach this machine. Set it to the Mac's network name
# (e.g. yourmac.local) to use the app from a phone on the same Wi-Fi.
PUBLIC_HOST=localhost

# Google sign-in: the OAuth web client ID. Leave empty to use dev login only.
GOOGLE_CLIENT_ID=

# Email-only sign-in for local development. Never enable in a deployed environment.
DEV_LOGIN=true

AUTH_SECRET_KEY=dev-secret-change-me
