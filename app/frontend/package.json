{
  "name": "prayer-deck",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc && vite build --minify false --mode development",
    "build": "tsc && vite build --mode production",
    "preview": "vite preview",
    "generate:api": "openapi-typescript ../../api/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@wailsio/runtime": "3.1.0",
    "motion": "^14.11.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.2.2",
    "vite": "^8.2.4"
  }
}
